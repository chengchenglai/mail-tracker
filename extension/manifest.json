{
  "manifest_version": 3,
  "name": "Mail Tracker for Gmail",
  "version": "1.3.1",
  "description": "Invisible open-tracking for Gmail (no visible signature), with reply detection and desktop notifications.",
  "permissions": ["storage", "alarms", "notifications", "declarativeNetRequest"],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://mailtrack-server.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      { "id": "own_pixel", "enabled": true, "path": "rules.json" }
    ]
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Mail Tracker"
  },
  "icons": {
    "128": "icon128.png"
  }
}
